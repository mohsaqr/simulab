Package: simulab
Title: Simulates a Wide Variety of Data Shapes, Sizes and Distributions
Version: 0.4.10
Authors@R: c(
    person("Mohammed", "Saqr", email = "saqr@saqr.me",
           role = c("aut", "cre", "cph"),
           comment = c(ORCID = "0000-0001-5881-3109")),
    person("Sonsoles", "L\u00f3pez-Pernas", email = "sonsoles.lopez@uef.fi",
